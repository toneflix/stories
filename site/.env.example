# Postgres connection string (Neon from the Vercel Marketplace works). Leave empty to use a local file database.
DATABASE_URL=

# Generate with: npx auth secret
AUTH_SECRET=

# Google sign-in: https://console.cloud.google.com/apis/credentials
# Redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email sign-in links through Resend: https://resend.com
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=Toneflix Stories <stories@toneflix.net>

